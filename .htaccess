Options -Indexes
RewriteEngine On

# Keep project internals out of the public web surface.
RewriteRule (^|/)\. - [F]
RewriteRule ^(config|docs|deployment|ai-gaurdrails)(/|$) - [F]
RewriteRule ^(api|dam)/.*\.(env|example|md|json|log|sql)$ - [F]
RewriteRule ^setup\.md$ - [F]

# Prevent internal rewrites from re-entering the API/DAM front controllers.
RewriteRule ^api/public/index\.php$ - [L]
RewriteRule ^dam/index\.php$ - [L]

# Public API: https://finmaster.cainethings.com/api/...
RewriteRule ^api(?:/(.*))?$ api/public/index.php [QSA,L]

# Public DAM asset streaming and management routes:
#   https://example.com/dam/{asset-id}
#   https://example.com/dam/assets
#   https://example.com/dam/health
RewriteRule ^dam/([0-9]+)$ dam/index.php [QSA,L]
RewriteRule ^dam(?:/(.*))?$ dam/index.php [QSA,L]

# Base domain serves the React build. Keep this before the directory
# short-circuit below because the document root itself is a directory.
RewriteRule ^$ frontend/dist/index.html [L]

# Serve frontend build assets from frontend/dist at the site root.
RewriteRule ^assets/(.+)$ frontend/dist/assets/$1 [L]
RewriteRule ^favicon\.svg$ frontend/dist/favicon.svg [L]
RewriteRule ^manifest\.webmanifest$ frontend/dist/manifest.webmanifest [L]
RewriteRule ^pwa-(192|512)\.svg$ frontend/dist/pwa-$1.svg [L]
RewriteRule ^sw\.js$ frontend/dist/sw.js [L]
RewriteRule ^workbox-.+\.js$ frontend/dist/$0 [L]

# Let actual project-root files resolve if they are explicitly public.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Serve frontend build files from frontend/dist at the site root.
RewriteCond frontend/dist/$1 -f
RewriteRule ^(.+)$ frontend/dist/$1 [L]

# Frontend deep links serve the React build.
RewriteRule ^.*$ frontend/dist/index.html [L]
